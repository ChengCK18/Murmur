{
  "uid": "murmur-fleet",
  "title": "Murmur fleet",
  "description": "What is stored: messages, alerts and the command audit log.",
  "tags": [
    "murmur"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "panels": [
    {
      "id": 15,
      "type": "timeseries",
      "title": "Messages stored per minute, by type",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 minute', received_at) AS time, msg_type AS metric, count(*) AS value\nFROM telemetry WHERE $__timeFilter(received_at)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "table",
      "title": "Alerts",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT at AS \"Time\", drone_id AS \"Drone\", details->>'kind' AS \"Kind\",\n  CASE WHEN (details->>'raised')::boolean THEN 'raised' ELSE 'cleared' END AS \"State\", details->>'message' AS \"Message\"\nFROM events WHERE type = 'alert' AND $__timeFilter(at) ORDER BY at DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 17,
      "type": "table",
      "title": "Commands",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT issued_at AS \"Time\", drone_id AS \"Drone\", type AS \"Command\", status AS \"Status\",\n  COALESCE(reason, '') AS \"Reason\", attempts AS \"Attempts\", issued_by AS \"User\"\nFROM commands WHERE $__timeFilter(issued_at) ORDER BY issued_at DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
